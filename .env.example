PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/stylesync
JWT_SECRET=super_secret_stylesync_jwt_key_2025_secure
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Optional - Fallbacks to base64 Data URIs if unset)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Email Service (Nodemailer - Gmail App Password or Resend/SendGrid)
# For Gmail: use your Gmail address and 16-character Google App Password (myaccount.google.com/apppasswords)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="StyleSync Support <noreply@stylesync.ai>"

